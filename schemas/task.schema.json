{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WARI HU task registry",
  "type": "object",
  "required": ["schemaVersion", "hu", "tasks", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hu": { "pattern": "^(MEWARI|DWARI)-[0-9]+$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["taskId", "hu", "role", "title", "state", "dependencies", "resources", "files", "evidence"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "hu": { "pattern": "^(MEWARI|DWARI)-[0-9]+$" },
          "role": { "enum": ["ANALISTA", "DESARROLLADOR", "QA", "INTEGRADOR", "DOCUMENTADOR"] },
          "state": { "enum": ["PENDING", "READY", "IN_PROGRESS", "REVIEW", "CORRECTION_REQUIRED", "WAITING_APPROVAL", "BLOCKED", "DONE", "CANCELLED"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "scope": { "type": "string" },
          "acceptanceCriteria": { "type": "string" },
          "evidenceRequired": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "correctionOf": { "type": "string" },
          "correctionRoot": { "type": "string" },
          "correctionCycle": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
